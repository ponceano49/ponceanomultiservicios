<ContentPage x:Class="PonceanoFacturador.Views.CompaniaPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Información de la Compañía">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Información de la Compañía" FontSize="26" FontAttributes="Bold" />
            <Button Text="Usar datos de Ponceano Servicios" Clicked="OnDatosPonceanoClicked" />
            <Entry x:Name="NombreEntry" Placeholder="Nombre de la empresa *" />
            <Entry x:Name="RncEntry" Placeholder="RNC / Cédula" />
            <Entry x:Name="CorreoEntry" Placeholder="Correo electrónico de facturación" Keyboard="Email" />
            <Entry x:Name="TelefonoEntry" Placeholder="Teléfono" />
            <Entry x:Name="DireccionEntry" Placeholder="Dirección completa" />
            <Entry x:Name="DireccionAdicionalEntry" Placeholder="Dirección adicional" />
            <Button Text="Cargar logo" Clicked="OnLogoClicked" />
            <Image x:Name="LogoPreview" HeightRequest="120" IsVisible="False" />
            <Label x:Name="MensajeLabel" TextColor="#C0392B" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="CANCELAR" Clicked="OnCancelarClicked" />
                <Button Grid.Column="1" Text="GUARDAR" Clicked="OnGuardarClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
