<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PonceanoFacturador.Views.FacturaEditarPage" Title="Nueva factura"
             Shell.NavBarIsVisible="False" BackgroundColor="White">
    <Grid x:Name="ContenidoDocumento" IsEnabled="False" RowDefinitions="Auto,*" Padding="18,8" RowSpacing="10">
        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Button Text="‹" Clicked="OnCancelarClicked" BackgroundColor="Transparent" TextColor="#65952B" FontSize="28" Padding="0" MinimumWidthRequest="32" MinimumHeightRequest="40" SemanticProperties.Description="Volver a facturas" />
                <Label Text="Factura" FontSize="24" TextColor="#737373" VerticalOptions="Center" />
                <Border BackgroundColor="#D0D0D0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,3" VerticalOptions="Center">
                    <Label x:Name="EstadoDocumentoLabel" Text="Nueva" TextColor="#555555" FontSize="11" />
                </Border>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                <VerticalStackLayout x:Name="EnviarMenuLayout" Spacing="0" VerticalOptions="Start">
                    <VerticalStackLayout.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnEnviarPointerEntered" PointerExited="OnEnviarPointerExited" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Button Text="Enviar ▾" Clicked="OnEnviarClicked" BackgroundColor="#F5F5F5" TextColor="#607080" Padding="10,3" FontSize="11" MinimumHeightRequest="38" />
                    <Border x:Name="EnviarPopup" IsVisible="False" Stroke="#D4D4D4" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="4" ZIndex="1">
                        <VerticalStackLayout Spacing="2">
                            <Button Text="Correo electrónico" Clicked="OnEnviarCorreoClicked" BackgroundColor="White" TextColor="#455A64" Padding="10,6" FontSize="12" HorizontalOptions="Fill" />
                            <Button Text="WhatsApp / Compartir" Clicked="OnEnviarCompartirClicked" BackgroundColor="White" TextColor="#455A64" Padding="10,6" FontSize="12" HorizontalOptions="Fill" />
                            <Button Text="Guardar como PDF" Clicked="OnEnviarCompartirClicked" BackgroundColor="White" TextColor="#455A64" Padding="10,6" FontSize="12" HorizontalOptions="Fill" />
                            <Button Text="Convertir a cotización" Clicked="OnConvertirMenuClicked" BackgroundColor="White" TextColor="#455A64" Padding="10,6" FontSize="12" HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <HorizontalStackLayout x:Name="AccionesDocumentoLayout" Spacing="5" IsVisible="False">
                    <Button Text="Copiar" Clicked="OnCopiarClicked" BackgroundColor="#F5F5F5" TextColor="#607080" Padding="8,3" FontSize="11" MinimumHeightRequest="38" />
                    <Button Text="Pago" Clicked="OnPagoClicked" BackgroundColor="#F5F5F5" TextColor="#607080" Padding="8,3" FontSize="11" MinimumHeightRequest="38" />
                    <Button Text="PDF" Clicked="OnVistaPreviaClicked" BackgroundColor="#F5F5F5" TextColor="#607080" Padding="8,3" FontSize="11" MinimumHeightRequest="38" />
                </HorizontalStackLayout>
                <Button Text="⋯" Clicked="OnAccionesClicked" BackgroundColor="#F65A21" TextColor="White" CornerRadius="24" FontSize="22" Padding="0" WidthRequest="46" HeightRequest="46" SemanticProperties.Description="Mostrar acciones del documento" />
            </HorizontalStackLayout>
        </FlexLayout>
        <ScrollView Grid.Row="1">
            <Border Stroke="#DFE4E8" StrokeThickness="1" BackgroundColor="White" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" Padding="16" AlignItems="Start">
                        <VerticalStackLayout Spacing="3" MinimumWidthRequest="250" FlexLayout.Grow="1">
                            <Label Text="Para" TextColor="#777777" FontAttributes="Bold" FontSize="13" />
                            <Picker x:Name="ClientePicker" Title="Selecciona un cliente *" ItemDisplayBinding="{Binding Nombre}" SelectedIndexChanged="OnClienteChanged" HorizontalOptions="Start" WidthRequest="250" />
                            <Label Text="RNC o cédula" TextColor="#777777" FontSize="12" />
                            <Entry x:Name="RncEntry" IsReadOnly="True" Placeholder="RNC o cédula" WidthRequest="250" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="135,180" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4" Padding="0,0,8,0">
                            <Label Text="Tipo de NCF" TextColor="#777777" VerticalOptions="Center" />
                            <Picker x:Name="TipoNcfPicker" Grid.Column="1" Title="Comprobante" SelectedIndexChanged="OnTipoNcfChanged" />
                            <Label Grid.Row="1" Text="NCF" TextColor="#777777" VerticalOptions="Center" />
                            <Entry x:Name="NcfEntry" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Placeholder="Al emitir" />
                            <Label Grid.Row="2" Text="Fecha" TextColor="#777777" VerticalOptions="Center" />
                            <Label x:Name="FechaDocumentoLabel" Grid.Row="2" Grid.Column="1" TextColor="#777777" VerticalOptions="Center" />
                            <Label Grid.Row="3" Text="Vence para" TextColor="#777777" VerticalOptions="Center" />
                            <DatePicker x:Name="VencimientoFechaPicker" Grid.Row="3" Grid.Column="1" Format="dd/MM/yyyy" />
                            <Switch x:Name="VencimientoEliminadoSwitch" Grid.Row="4" Toggled="OnVencimientoEliminadoChanged" HorizontalOptions="Start" />
                            <Label Grid.Row="4" Grid.Column="1" Text="Eliminar fecha de vencimiento" FontSize="12" TextColor="#777777" VerticalOptions="Center" />
                        </Grid>
                    </FlexLayout>
                    <Label Text="La secuencia NCF es local; verifica tu numeración fiscal autorizada antes de emitir." TextColor="#9C5700" FontSize="11" Margin="16,0,16,8" />
                    <Label x:Name="VenceLabel" TextColor="#777777" FontSize="11" Margin="16,0,16,8" />
                    <ScrollView x:Name="TablaScroll" Orientation="Horizontal" HorizontalScrollBarVisibility="Default" SizeChanged="OnTablaSizeChanged">
                        <VerticalStackLayout x:Name="TablaLayout" MinimumWidthRequest="650" HorizontalOptions="Start" Spacing="0">
                            <Grid ColumnDefinitions="*,75,110,110,55" Padding="8,6" BackgroundColor="#FAFAFA">
                                <Label Text="Artículo" FontAttributes="Bold" FontSize="12" TextColor="#777777" />
                                <Label Grid.Column="1" Text="Cantidad" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="Precio" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="Importe" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="End" />
                                <Label Grid.Column="4" Text="Acción" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" />
                            </Grid>
                            <VerticalStackLayout x:Name="ItemsContainer" Spacing="0" />
                        </VerticalStackLayout>
                    </ScrollView>
                    <HorizontalStackLayout x:Name="ItemsActionsLayout" Spacing="8" HorizontalOptions="Center" Margin="8,14">
                        <Button Text="+ Agregar artículo" Clicked="OnAgregarArticuloClicked" BackgroundColor="#55B85B" TextColor="White" CornerRadius="18" Padding="12,4" MinimumHeightRequest="36" />
                        <Button Text="+ Línea libre" Clicked="OnAgregarItemClicked" BackgroundColor="#F1F1F1" TextColor="#607080" CornerRadius="18" Padding="12,4" MinimumHeightRequest="36" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" Color="#DDDDDD" />
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" Padding="12" AlignItems="Start">
                        <VerticalStackLayout Spacing="4" MinimumWidthRequest="250" FlexLayout.Grow="1">
                            <Label Text="Impuesto y firmas" TextColor="#268DD0" FontSize="13" />
                            <HorizontalStackLayout Spacing="6"><CheckBox x:Name="MiFirmaCheck" CheckedChanged="OnMiFirmaChanged"/><Label Text="Mi firma" TextColor="#777777" VerticalOptions="Center"/></HorizontalStackLayout>
                            <Button x:Name="CargarFirmaButton" Text="Cargar imagen de mi firma" Clicked="OnCargarFirmaClicked" IsVisible="False" HorizontalOptions="Start" />
                            <Image x:Name="FirmaPreview" HeightRequest="80" IsVisible="False" HorizontalOptions="Start" />
                            <HorizontalStackLayout Spacing="6"><CheckBox x:Name="FirmaClienteCheck" CheckedChanged="OnFirmaClienteChanged"/><Label Text="Firma del cliente" TextColor="#777777" VerticalOptions="Center"/></HorizontalStackLayout>
                            <Button x:Name="CargarFirmaClienteButton" Text="Cargar imagen de la firma del cliente" Clicked="OnCargarFirmaClienteClicked" IsVisible="False" HorizontalOptions="Start" />
                            <Image x:Name="FirmaClientePreview" HeightRequest="80" IsVisible="False" HorizontalOptions="Start" />
                            <Button x:Name="SolicitarFirmaButton" Text="Enviar solicitud de firma al cliente por correo" Clicked="OnSolicitarFirmaClicked" IsVisible="False" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="10" MinimumWidthRequest="230" HorizontalOptions="End">
                            <Label x:Name="SubtotalLabel" Text="Subtotal: RD$0.00" TextColor="#777777" HorizontalTextAlignment="End" />
                            <Label x:Name="ItbisLabel" Text="ITBIS (18%): RD$0.00" TextColor="#777777" HorizontalTextAlignment="End" />
                            <Label x:Name="RecargoLabel" IsVisible="False" TextColor="#777777" HorizontalTextAlignment="End" />
                            <Label x:Name="TotalLabel" Text="Total: RD$0.00" TextColor="#588A1A" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </FlexLayout>
                    <BoxView HeightRequest="1" Color="#DDDDDD" />
                    <VerticalStackLayout Padding="16" Spacing="6">
                        <Label Text="Pago" TextColor="#777777" FontAttributes="Bold" />
                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                            <Picker x:Name="EstadoPagoPicker" Title="Estado del pago" WidthRequest="180" />
                            <Picker x:Name="MetodoPagoPicker" Title="Método de pago" WidthRequest="200" />
                        </FlexLayout>
                        <Label Text="El estado pagada/pendiente es un registro manual; no verifica ni procesa transacciones." FontSize="11" TextColor="#805500" />
                        <Label x:Name="PagoInfoLabel" FontSize="12" TextColor="#555555" />
                        <Label Text="Nota" TextColor="#777777" FontAttributes="Bold" />
                        <Editor x:Name="NotaEditor" Placeholder="Nota que aparecerá en el PDF" AutoSize="TextChanges" />
                        <Label x:Name="MensajeLabel" TextColor="#C0392B" />
                        <HorizontalStackLayout x:Name="ImprimirYCerrarLayout" Spacing="6" IsVisible="False">
                            <CheckBox x:Name="ImprimirYCerrarCheck" />
                            <Label Text="Emitir, abrir la vista previa (elige impresora/copias allí) y cerrar esta pantalla" FontSize="12" TextColor="#60788F" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <FlexLayout Wrap="Wrap" JustifyContent="End" AlignItems="Center">
                            <Button Text="Cancelar" Clicked="OnCancelarClicked" BackgroundColor="#F1F1F1" TextColor="#555555" Margin="3" />
                            <Button x:Name="BorradorButton" Text="Guardar borrador" Clicked="OnBorradorClicked" BackgroundColor="#6D8DA1" TextColor="White" Margin="3" />
                            <Button x:Name="GuardarButton" Text="Guardar y emitir" Clicked="OnGuardarClicked" BackgroundColor="#55B85B" TextColor="White" Margin="3" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
