<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PonceanoFacturador.Views.LoginPage" Title="Iniciar sesión">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12" MaximumWidthRequest="500">
            <Label Text="Ponceano Multiservicios" FontSize="28" FontAttributes="Bold" />
            <Label Text="Iniciar Sesión" FontSize="18" />
            <Entry x:Name="CorreoEntry" Placeholder="Correo electrónico" Keyboard="Email" TextChanged="OnInputChanged" />
            <Entry x:Name="ContrasenaEntry" Placeholder="Contraseña" IsPassword="True" TextChanged="OnInputChanged" />
            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="RecordarmeCheck" />
                <Label Text="Recordarme en este dispositivo" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button x:Name="IngresarButton" Text="Iniciar Sesión" Clicked="OnLoginClicked" />
            <Button x:Name="RecuperarButton" Text="¿Olvidaste tu contraseña?" Clicked="OnResetClicked" />
            <Button x:Name="RegistroButton" Text="¿No tienes cuenta? Regístrate aquí" Clicked="OnRegisterClicked" />
            <ActivityIndicator x:Name="Loading" IsVisible="False" />
            <Label x:Name="MensajeLabel" TextColor="#C0392B" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>