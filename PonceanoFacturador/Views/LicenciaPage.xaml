<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PonceanoFacturador.Views.LicenciaPage" Title="Mi Licencia">
    <ScrollView><VerticalStackLayout Padding="24" Spacing="14">
        <Label Text="Mi Suscripción" FontSize="28" FontAttributes="Bold" />
        <Border Padding="16"><VerticalStackLayout Spacing="8"><Label x:Name="TipoLabel" FontSize="20" FontAttributes="Bold"/><Label x:Name="EstadoLabel"/><Label x:Name="VencimientoLabel"/><Label x:Name="FacturasLabel"/><Label x:Name="CotizacionesLabel"/></VerticalStackLayout></Border>
        <Label Text="Planes de licencia (pago único)" FontSize="20" FontAttributes="Bold" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Padding="14"><VerticalStackLayout><Label Text="⭐ PLAN MENSUAL" FontAttributes="Bold"/><Label Text="US$35 — 30 días"/><Label Text="Acceso PRO durante el período"/></VerticalStackLayout></Border>
            <Border Grid.Column="1" Padding="14"><VerticalStackLayout><Label Text="⭐ PLAN ANUAL" FontAttributes="Bold"/><Label Text="US$360 — 365 días"/><Label Text="Acceso PRO durante el período"/></VerticalStackLayout></Border>
        </Grid>
        <Label Text="El precio se valida en el servidor. El pago se procesa en PayPal Sandbox; la licencia se activa solo después de confirmar el cobro." FontSize="12" TextColor="#805500" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="COMPRAR MENSUAL — US$35" Clicked="OnComprarMensualClicked" />
            <Button Grid.Column="1" Text="COMPRAR ANUAL — US$360" Clicked="OnComprarAnualClicked" />
        </Grid>
        <Button x:Name="VerificarPagoButton" Text="YA COMPLETÉ EL PAGO — ACTUALIZAR LICENCIA" Clicked="OnVerificarPagoClicked" />
        <Label x:Name="MensajeLabel" TextColor="#C0392B" />
        <Button Text="CERRAR" Clicked="OnVolverClicked" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
