<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PonceanoFacturador.Views.NotaCreditoEditarPage" Title="Nota de crédito"
             Shell.NavBarIsVisible="False" BackgroundColor="White">
    <Grid x:Name="ContenidoDocumento" IsEnabled="False" Padding="18,8" RowDefinitions="Auto,*" RowSpacing="10">
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Button Text="‹" Clicked="OnCancelarClicked" BackgroundColor="Transparent" TextColor="#65952B" FontSize="28" Padding="0" MinimumWidthRequest="32" MinimumHeightRequest="40" SemanticProperties.Description="Volver a notas de crédito" />
            <Label Text="Nota de crédito" FontSize="24" TextColor="#737373" VerticalOptions="Center" />
            <Border BackgroundColor="#D0D0D0" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,3" VerticalOptions="Center"><Label x:Name="EstadoLabel" Text="Nueva" TextColor="#555555" FontSize="11" /></Border>
        </HorizontalStackLayout>
        <ScrollView Grid.Row="1">
            <Border Stroke="#DFE4E8" StrokeThickness="1" BackgroundColor="White" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" Padding="16" AlignItems="Start">
                        <VerticalStackLayout Spacing="4" MinimumWidthRequest="250" FlexLayout.Grow="1">
                            <Label Text="Para" TextColor="#777777" FontAttributes="Bold" FontSize="13" />
                            <Picker x:Name="ClientePicker" Title="Selecciona un cliente *" ItemDisplayBinding="{Binding Nombre}" SelectedIndexChanged="OnClienteChanged" WidthRequest="250" HorizontalOptions="Start" />
                            <Label x:Name="ClienteDetalleLabel" IsVisible="False" TextColor="#777777" />
                            <Label x:Name="RncLabel" TextColor="#777777" FontSize="12" />
                            <Label Text="Factura relacionada (opcional)" TextColor="#777777" FontSize="12" />
                            <Picker x:Name="FacturaPicker" Title="Sin factura relacionada" ItemDisplayBinding="{Binding Texto}" SelectedIndexChanged="OnFacturaChanged" WidthRequest="300" HorizontalOptions="Start" />
                            <Label x:Name="FacturaDetalleLabel" IsVisible="False" TextColor="#777777" />
                            <Label Text="Motivo *" TextColor="#777777" FontSize="12" />
                            <Picker x:Name="MotivoPicker" Title="Selecciona el motivo" WidthRequest="250" HorizontalOptions="Start" />
                            <Label x:Name="MotivoDetalleLabel" IsVisible="False" TextColor="#777777" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="135,180" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                            <Label Text="Nota de crédito #" TextColor="#777777" VerticalOptions="Center" />
                            <Label x:Name="NcfLabel" Grid.Column="1" Text="Al emitir" TextColor="#777777" VerticalOptions="Center" />
                            <Label Grid.Row="1" Text="Fecha" TextColor="#777777" VerticalOptions="Center" />
                            <Label x:Name="FechaLabel" Grid.Row="1" Grid.Column="1" TextColor="#777777" VerticalOptions="Center" />
                        </Grid>
                    </FlexLayout>
                    <ScrollView x:Name="TablaScroll" Orientation="Horizontal" SizeChanged="OnTablaSizeChanged">
                        <VerticalStackLayout x:Name="TablaLayout" MinimumWidthRequest="650" HorizontalOptions="Start" Spacing="0">
                            <Grid ColumnDefinitions="*,75,110,110,55" Padding="8,6" BackgroundColor="#FAFAFA">
                                <Label Text="Artículo" FontAttributes="Bold" FontSize="12" TextColor="#777777" />
                                <Label Grid.Column="1" Text="Cantidad" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="Precio" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="Importe" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="End" />
                                <Label Grid.Column="4" Text="Acción" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" />
                            </Grid>
                            <VerticalStackLayout x:Name="ItemsContainer" Spacing="0" />
                        </VerticalStackLayout>
                    </ScrollView>
                    <HorizontalStackLayout x:Name="ItemsActionsLayout" Spacing="8" HorizontalOptions="Center" Margin="8,14">
                        <Button Text="+ Agregar artículo" Clicked="OnAgregarArticuloClicked" BackgroundColor="#55B85B" TextColor="White" CornerRadius="18" Padding="12,4" MinimumHeightRequest="36" />
                        <Button Text="+ Línea libre" Clicked="OnAgregarItemClicked" BackgroundColor="#F1F1F1" TextColor="#607080" CornerRadius="18" Padding="12,4" MinimumHeightRequest="36" />
                    </HorizontalStackLayout>
                    <BoxView HeightRequest="1" Color="#DDDDDD" />
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" Padding="12" AlignItems="Start">
                        <VerticalStackLayout Spacing="6" MinimumWidthRequest="250" FlexLayout.Grow="1">
                            <Label Text="Impuesto" TextColor="#268DD0" FontSize="13" />
                            <Label Text="El saldo se estima restando las notas de crédito registradas al total de la factura; no considera pagos." FontSize="12" TextColor="#805500" />
                            <Label Text="Las notas de crédito de esta pantalla no devuelven inventario. La devolución completa se realiza al anular la factura; las devoluciones parciales estarán disponibles próximamente." FontSize="12" TextColor="#805500" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="10" MinimumWidthRequest="230" HorizontalOptions="End">
                            <Label x:Name="SubtotalLabel" Text="Subtotal: RD$ 0.00" TextColor="#777777" HorizontalTextAlignment="End" />
                            <Label x:Name="ItbisLabel" Text="ITBIS: RD$ 0.00" TextColor="#777777" HorizontalTextAlignment="End" />
                            <Label x:Name="TotalLabel" Text="Total: RD$ 0.00" TextColor="#588A1A" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </FlexLayout>
                    <Label x:Name="MensajeLabel" TextColor="#C0392B" Margin="16,0" />
                    <FlexLayout Wrap="Wrap" JustifyContent="End" Padding="16" AlignItems="Center">
                        <Button Text="Volver" Clicked="OnCancelarClicked" BackgroundColor="#F1F1F1" TextColor="#555555" Margin="3" />
                        <Button x:Name="CopiarButton" Text="Crear copia editable" Clicked="OnCopiarClicked" IsVisible="False" Margin="3" />
                        <Button x:Name="BorradorButton" Text="Guardar borrador" Clicked="OnBorradorClicked" BackgroundColor="#6D8DA1" TextColor="White" Margin="3" />
                        <Button x:Name="GuardarButton" Text="Guardar y emitir" Clicked="OnGuardarClicked" BackgroundColor="#55B85B" TextColor="White" Margin="3" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
