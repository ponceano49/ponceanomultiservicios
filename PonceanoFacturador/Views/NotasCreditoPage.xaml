<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PonceanoFacturador.Models"
                       x:Class="PonceanoFacturador.Views.NotasCreditoPage" Title="Notas de Crédito" Shell.NavBarIsVisible="False">
             <ContentPage.ToolbarItems>
                 <ToolbarItem Text="+ Nuevo" Order="Primary" Priority="0" Clicked="OnNuevaClicked" />
             </ContentPage.ToolbarItems>
             <Grid Padding="18,8" RowDefinitions="Auto,*,Auto" RowSpacing="12" BackgroundColor="White">
                 <Grid x:Name="HeaderGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="14" SizeChanged="OnHeaderSizeChanged">
                     <FlexLayout x:Name="HeaderActions" Wrap="Wrap" AlignItems="Center">
                         <Label x:Name="NotasIconoLabel" Text="▧" FontSize="23" TextColor="#678096" VerticalOptions="Center" />
                         <Label x:Name="NotasTituloLabel" Text="Notas de crédito" FontSize="24" TextColor="#667D91" VerticalOptions="Center" />
                         <Button x:Name="NuevoContentButton" Text="+ Nuevo" Clicked="OnNuevaClicked" BackgroundColor="#55B85B" TextColor="White" CornerRadius="18" Padding="12,3" HeightRequest="32" MinimumHeightRequest="32" FontAttributes="Bold" />
                     </FlexLayout>
                     <VerticalStackLayout x:Name="SearchFilters" Grid.Column="1" Spacing="1" HorizontalOptions="End">
                <HorizontalStackLayout Spacing="6">
                    <Picker x:Name="FiltroPicker" Title="Todo" SelectedIndexChanged="OnFiltroChanged" WidthRequest="110" FontSize="12" />
                    <SearchBar x:Name="BuscarBar" Placeholder="Buscar nota" TextChanged="OnBuscarChanged" WidthRequest="180" FontSize="12" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="3" HorizontalOptions="End"><CheckBox x:Name="BusquedaProfundaCheck" CheckedChanged="OnBusquedaProfundaChanged" Scale="0.7" /><Label Text="Deep Search" FontSize="10" TextColor="#687D90" VerticalOptions="Center" /></HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
        <Border x:Name="TablaContainer" Grid.Row="1" Stroke="#DCE1E6" StrokeThickness="1" Padding="0">
            <Grid RowDefinitions="48,*">
                <Grid ColumnDefinitions="0.95*,1.1*,1.35*,4*,1.25*,34" Padding="12,4">
                    <Label Text="Estado" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Fecha" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="No." FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="Cliente" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="Importe" FontAttributes="Bold" FontSize="12" TextColor="#777777" HorizontalTextAlignment="End" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" VerticalOptions="End" Color="#D6D6D6" />
                <CollectionView x:Name="Lista" Grid.Row="1" SelectionMode="None">
                    <CollectionView.EmptyView><Label Text="No hay notas de crédito para mostrar." TextColor="#718096" HorizontalOptions="Center" VerticalOptions="Center" /></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate><DataTemplate x:DataType="models:NotaCredito">
                        <Grid ColumnDefinitions="0.95*,1.1*,1.35*,4*,1.25*,34" Padding="12,4" HeightRequest="52" BackgroundColor="#FAFAFA">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnFilaTapped" /></Grid.GestureRecognizers>
                            <Border BackgroundColor="#B7B7B7" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="7,2" HorizontalOptions="Center" VerticalOptions="Center"><Label Text="{Binding Estado}" TextColor="White" FontSize="10" /></Border>
                            <Label Grid.Column="1" Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#60788F" FontSize="12" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="{Binding NCF}" TextColor="#60788F" FontSize="12" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="3" Text="{Binding ClienteNombre}" TextColor="#60788F" FontSize="12" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="4" Text="{Binding Total, StringFormat='{0:C}'}" TextColor="#298333" FontSize="12" VerticalOptions="Center" HorizontalTextAlignment="End" />
                            <Button Grid.Column="5" Text="⋮" TextColor="#54718A" BackgroundColor="Transparent" Padding="0" HeightRequest="30" MinimumHeightRequest="30" Clicked="OnFilaAccionesClicked" FontSize="18" />
                            <BoxView Grid.ColumnSpan="6" VerticalOptions="End" HeightRequest="1" Color="#E2E2E2" />
                        </Grid>
                    </DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
        <Label x:Name="MensajeLabel" Grid.Row="2" TextColor="#C0392B" FontSize="12" />
    </Grid>
</ContentPage>
