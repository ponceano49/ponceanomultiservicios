<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PonceanoFacturador.Views.ClienteEditarPage" Title="Cliente">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" MaximumWidthRequest="600">
            <Label x:Name="TituloLabel" FontSize="24" FontAttributes="Bold" />
            <Label Text="Nombre completo *" />
            <Entry x:Name="NombreEntry" MaxLength="150" />
            <Label Text="RNC o cédula (9 a 11 dígitos) *" />
            <Entry x:Name="RncEntry" Keyboard="Numeric" MaxLength="11" />
            <Button Text="🔍 Verificar RNC en el padrón local" Clicked="OnVerificarRncClicked" />
            <Label x:Name="VerificacionRncLabel" FontSize="12" TextColor="#805500" />
            <Label Text="Dirección *" />
            <Entry x:Name="DireccionEntry" MaxLength="250" />
            <Label Text="Teléfono *" />
            <Entry x:Name="TelefonoEntry" Keyboard="Telephone" />
            <Label Text="Correo electrónico (opcional)" />
            <Entry x:Name="CorreoEntry" Keyboard="Email" />
            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="ContribuyenteCheck" />
                <Label Text="Es contribuyente" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label x:Name="MensajeLabel" TextColor="#C0392B" />
            <Button x:Name="GuardarButton" Text="Guardar" Clicked="OnGuardarClicked" />
            <Button x:Name="CancelarButton" Text="Cancelar" Clicked="OnCancelarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
