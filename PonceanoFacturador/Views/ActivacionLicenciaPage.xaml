<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PonceanoFacturador.Views.ActivacionLicenciaPage"
             Title="Licencia" Shell.NavBarIsVisible="False" BackgroundColor="White">
    <Grid Padding="24">
        <ScrollView>
        <VerticalStackLayout x:Name="ContenidoLicencia" Spacing="16" MaximumWidthRequest="560" VerticalOptions="Center" HorizontalOptions="Center">
            <Label x:Name="TituloLabel" Text="ACTIVAR PRUEBA GRATUITA DE 30 DÍAS" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#263746" />
            <Label x:Name="MensajeLabel" HorizontalTextAlignment="Center" TextColor="#60788F" />
            <Label x:Name="EstadoLabel" HorizontalTextAlignment="Center" TextColor="#9A5A00" />
            <Button x:Name="ActivarButton" Text="✅ ACTIVAR PRUEBA GRATUITA DE 30 DÍAS" Clicked="OnActivarClicked" BackgroundColor="#267344" TextColor="White" IsVisible="False" />
            <Button x:Name="ComprarButton" Text="ADQUIRIR / RENOVAR LICENCIA COMPLETA" Clicked="OnComprarClicked" BackgroundColor="#467FA6" TextColor="White" />
            <Button x:Name="ReintentarButton" Text="🔄 VOLVER A VALIDAR LICENCIA" Clicked="OnReintentarClicked" BackgroundColor="#60788F" TextColor="White" />
            <Label Text="La prueba se vincula a este dispositivo y cuenta. El envío automático por API DGII continúa pendiente de autorización oficial." FontSize="12" HorizontalTextAlignment="Center" TextColor="#9A5A00" />
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
