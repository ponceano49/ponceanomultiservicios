<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PonceanoFacturador.Models"
                       x:Class="PonceanoFacturador.Views.ClientesPage" Title="Clientes">
             <ContentPage.ToolbarItems>
                 <ToolbarItem Text="+ Nuevo" Order="Primary" Priority="0" Clicked="OnNuevoClicked" />
             </ContentPage.ToolbarItems>
             <Grid Padding="18,8" RowDefinitions="Auto,*,Auto" RowSpacing="12" BackgroundColor="White">
                 <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,Auto,Auto,*,360" RowDefinitions="Auto" ColumnSpacing="8" Padding="0,4,0,10" SizeChanged="OnHeaderSizeChanged">
                     <HorizontalStackLayout x:Name="TituloHeader" Grid.Column="0" Spacing="8" VerticalOptions="Center">
                         <Label Text="♟" FontSize="23" TextColor="#687D90" VerticalOptions="Center" />
                         <Label Text="Lista de Cliente" FontSize="24" TextColor="#687D90" VerticalOptions="Center" />
                     </HorizontalStackLayout>
                     <Button x:Name="NuevoButton" Grid.Column="1" Text="+ Nuevo" Clicked="OnNuevoClicked" BackgroundColor="#55B85B" TextColor="White" CornerRadius="18" Padding="12,3" HeightRequest="32" MinimumHeightRequest="32" FontAttributes="Bold" />
                     <Button x:Name="InformacionButton" Grid.Column="2" Text="ⓘ" Clicked="OnInformacionClicked" BackgroundColor="White" TextColor="#536A7D" BorderColor="#D0D0D0" BorderWidth="1" CornerRadius="17" Padding="4,0" HeightRequest="32" MinimumHeightRequest="32" WidthRequest="34" />
                     <SearchBar x:Name="BuscarBar" Grid.Column="4" Placeholder="Buscar cliente" TextChanged="OnBuscarChanged" HeightRequest="38" VerticalOptions="Center" />
        </Grid>
        <Border Grid.Row="1" Stroke="#DCE1E6" StrokeThickness="1" Padding="0">
            <Grid RowDefinitions="48,*">
                <Grid ColumnDefinitions="*,90" Padding="8,8" BackgroundColor="White">
                    <Label Text="Compañía" FontAttributes="Bold" TextColor="#777777" FontSize="12" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Acciones" FontAttributes="Bold" TextColor="#777777" FontSize="12" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" VerticalOptions="End" Color="#D6D6D6" />
                <CollectionView x:Name="ClientesLista" Grid.Row="1">
                    <CollectionView.EmptyView><Label Text="Aún no hay clientes para mostrar." HorizontalOptions="Center" VerticalOptions="Center" TextColor="#718096" /></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate><DataTemplate x:DataType="models:Cliente">
                        <Grid ColumnDefinitions="*,90" Padding="8,6" MinimumHeightRequest="54" BackgroundColor="#FAFAFA">
                            <Label Text="{Binding Nombre}" TextColor="#60788F" FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                                <Button Text="✎" Clicked="OnFilaEditarClicked" BackgroundColor="#378BC5" TextColor="White" CornerRadius="6" Padding="4,0" WidthRequest="36" HeightRequest="40" MinimumWidthRequest="36" MinimumHeightRequest="40" />
                                <Button Text="▣" Clicked="OnFilaEliminarClicked" BackgroundColor="#E44D4D" TextColor="White" CornerRadius="6" Padding="4,0" WidthRequest="36" HeightRequest="40" MinimumWidthRequest="36" MinimumHeightRequest="40" />
                            </HorizontalStackLayout>
                            <BoxView Grid.ColumnSpan="2" VerticalOptions="End" HeightRequest="1" Color="#DDDDDD" />
                        </Grid>
                    </DataTemplate></CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
        <Label x:Name="MensajeLabel" Grid.Row="2" TextColor="#C0392B" FontSize="12" />
    </Grid>
</ContentPage>
