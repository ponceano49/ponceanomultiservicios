<ContentPage x:Class="PonceanoFacturador.MainPage" Title="Inicio">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18">
            <Label x:Name="BienvenidaLabel" FontSize="28" FontAttributes="Bold" />
            <Label Text="Resumen del día" FontSize="20" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                <Border Padding="16"><VerticalStackLayout><Label Text="Facturas emitidas hoy"/><Label x:Name="FacturasLabel" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border>
                <Border Grid.Column="1" Padding="16"><VerticalStackLayout><Label Text="Total del día"/><Label x:Name="VentasHoyLabel" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border>
            </Grid>
            <Label Text="Resumen mensual" FontSize="20" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                <Border Padding="16"><VerticalStackLayout><Label Text="Total facturado este mes"/><Label x:Name="VentasMesLabel" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border>
                <Border Grid.Column="1" Padding="16"><VerticalStackLayout><Label Text="ITBIS neto del mes"/><Label x:Name="ItbisLabel" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16"><VerticalStackLayout><Label Text="Cotizaciones este mes"/><Label x:Name="CotizacionesLabel" FontSize="24" FontAttributes="Bold"/></VerticalStackLayout></Border>
            </Grid>
            <Label x:Name="LicenciaLabel" FontSize="16" FontAttributes="Bold" />
            <Button Text="Mi Suscripción" Clicked="OnLicenciaClicked" />
            <Label Text="Acciones rápidas" FontSize="20" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
                <Button Text="Nueva Factura" Clicked="OnNuevaFacturaClicked" />
                <Button Grid.Column="1" Text="Nuevo Cliente" Clicked="OnNuevoClienteClicked" />
                <Button Grid.Row="1" Grid.ColumnSpan="2" Text="Nueva Cotización" Clicked="OnNuevaCotizacionClicked" />
            </Grid>
            <Button Text="Reportes / Exportar CSV" Clicked="OnExportarClicked" />
            <Label Text="Próximos vencimientos / facturas pendientes" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="PendientesLabel" />
            <Label x:Name="MensajeLabel" TextColor="#287A45" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
